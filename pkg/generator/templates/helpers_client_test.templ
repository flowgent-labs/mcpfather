func TestSanitizeForJSON(t *testing.T) {
	t.Run("float64 no sci", func(t *testing.T) {
		result := sanitizeForJSON(1e10)
		if stringResult, ok := result.([]byte); ok {
			if string(stringResult) != "10000000000" {
				t.Errorf("got %q, want %q", string(stringResult), "10000000000")
			}
		}
	})
	t.Run("nested map", func(t *testing.T) {
		result := sanitizeForJSON(map[string]interface{}{"count": float64(100)})
		m := result.(map[string]interface{})
		if m == nil {
			t.Error("map should not be nil")
		}
	})
	t.Run("simple string passthrough", func(t *testing.T) {
		result := sanitizeForJSON("hello")
		if result.(string) != "hello" {
			t.Error("string should pass through")
		}
	})
}

func TestMarshalJSONNoSci(t *testing.T) {
