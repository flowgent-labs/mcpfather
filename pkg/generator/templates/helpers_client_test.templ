func TestBuildJSONBody(t *testing.T) {
	args := map[string]interface{}{
		"body":  "should be in body",
		"name":  "test",
		"age":   42,
		"debug": true,
	}
	pathKeys := []string{"name"}
	result := buildJSONBody(args, pathKeys)
	if _, ok := result["name"]; ok {
		t.Error("path key 'name' should be excluded from body")
	}
	if _, ok := result["body"]; !ok {
		t.Error("body key should be in body")
	}
	if v, ok := result["age"]; !ok || v != 42 {
		t.Errorf("age should be 42, got %v", v)
	}
}

