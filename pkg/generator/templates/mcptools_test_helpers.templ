package mcptools

import (
	"testing"

	mcputils "{{.ModuleName}}/pkg/helpers"
)

// installTestConfig loads environment overrides into the global configuration
// used by generated handlers and restores the previous configuration afterward.
func installTestConfig(t *testing.T, serviceName string) {
	t.Helper()

	previous := mcputils.GetConfig()
	t.Setenv("HOME", t.TempDir())
	cfg, err := mcputils.LoadConfig(serviceName)
	if err != nil {
		t.Fatalf("load test config: %v", err)
	}
	mcputils.SetConfig(cfg)
	t.Cleanup(func() {
		mcputils.SetConfig(previous)
	})
}
